{
  "name": "personal-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "test": "vitest run",
    "og:refresh": "node scripts/fetch-og.mjs --refresh",
    "build": "node scripts/fetch-og.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/build-sitemap.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0-alpha.8",
    "@tanstack/react-router": "^1.114.0",
    "clsx": "^2.1.1",
    "front-matter": "^4.0.2",
    "lucide-react": "^0.487.0",
    "mermaid": "^12.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/router-plugin": "^1.114.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "only-allow": "^1.2.2",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vite-imagetools": "^7.0.6",
    "vite-plugin-font": "^1.3.0",
    "vitest": "^3.0.9",
    "yaml": "^2.7.0"
  }
}
